proxmox_endpoint  = "https://192.168.100.20:8006/"
proxmox_api_token = "terraform@pve!provider-token="

# iso_file_id ("local:iso/ubuntu-26.04-desktop-amd64.iso" по умолчанию —
# см. variables.tf) уже зашит в default var.nodes, менять/оверрайдить тут
# не нужно, если файл называется так же. Перед apply образ должен уже
# лежать в датасторе на pve-rog: /var/lib/vz/template/iso/ (scp/rsync)
# или через веб-UI (Datacenter → pve-rog → local → ISO Images → Upload).
